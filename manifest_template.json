{
  "manifest_version": 3,
  "name": "Photo Calendar",
  "version": "1.0",
  "description": "Simple browser extensions for viewing photos by date on a calendar.",
  "permissions": ["identity", "storage"],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "[YOUR OAUTH2 ID HERE]",
    "scopes": ["https://www.googleapis.com/auth/drive.readonly"]
  }
}